# ============================================
# MongoDB Atlas Configuration
# ============================================
# Pasos para obtener tu MONGO_URI:
# 1. Ve a https://cloud.mongodb.com
# 2. Crea un cluster (M0 FREE es gratis)
# 3. Database Access → Add New Database User (guarda username/password)
# 4. Network Access → Add IP Address → Allow Access from Anywhere (0.0.0.0/0)
# 5. Databases → Connect → Connect your application → Copy connection string
# 6. Reemplaza <password> con tu contraseña real
# 7. Reemplaza el nombre de la base de datos (después de .net/) con 'auth-service'
#
# Ejemplo:
# MONGO_URI=mongodb+srv://authservice:MyPassword123@cluster0.abc12.mongodb.net/auth-service?retryWrites=true&w=majority
#
# Para desarrollo local (sin MongoDB Atlas), deja la URI de localhost:
MONGO_URI=mongodb://localhost:27017/authdb

# ============================================
# JWT Configuration
# ============================================
# Genera un secreto seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_secret_in_production_use_long_random_string
JWT_EXPIRATION=3600s

# ============================================
# Server Configuration
# ============================================
PORT=3001
NODE_ENV=development
