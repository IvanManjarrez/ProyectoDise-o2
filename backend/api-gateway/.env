# API Gateway
PORT=3000
NODE_ENV=development

# Services URLs
AUTH_SERVICE_URL=http://localhost:3001
COMPOSITION_SERVICE_URL=http://localhost:3002
MUSEUM_PROXY_SERVICE_URL=http://localhost:3010

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100